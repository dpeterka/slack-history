# Slack Configuration
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL

# Anthropic Claude API Configuration
CLAUDE_API_KEY=sk-ant-api03-xxx
CLAUDE_MODEL=claude-sonnet-4-5

# RSS Feed Configuration (comma-separated list of URLs)
RSS_FEED_URLS=https://www.onthisday.com/rss/today-in-history.xml,https://unbelievablefactsblog.com/rss,http://feeds.feedburner.com/FutilityCloset,https://www.kickassfacts.com/feed/,https://www.mentalfloss.com/feed

# Holiday Feed Configuration (fun/unusual holidays)
HOLIDAY_FEED_URL=https://api.checkiday.com/rss?tz=America/New_York

# Scheduler Configuration
# Cron expression: "minute hour * * *" (5-field standard cron format)
# The system automatically adds seconds (0) at the start for the cron library
# Default: "0 9 * * *" (9:00 AM daily)
SCHEDULE_CRON="0 9 * * *"

# Run once and exit (for testing)
RUN_ONCE=false

# Skip running job immediately on container startup
# When true, waits for first scheduled time instead of running immediately
# Default: false (runs immediately on startup, then follows schedule)
SKIP_INITIAL_RUN=false

# Number of historical events to select and post
MAX_EVENTS=1

# Number of fun holidays to display
MAX_HOLIDAYS=2

# Variety Features
# Include inspirational quote of the day
INCLUDE_QUOTE=true

# Include notable births and deaths from history
# Uses Wikipedia API for clean, structured birth/death data
INCLUDE_PEOPLE=true

# Include emo/philosophical comment about work, life, or relationships
INCLUDE_EMO_COMMENT=true

# Include fascinating Mr Blobby facts
INCLUDE_BLOBBY_FACT=true

# Include WikiHow articles (the worst/funniest ones)
INCLUDE_WIKIHOW=true

# Include WikiHow personality quizzes (e.g. "Am I Pretty Quiz", "What Is My Spirit Animal")
INCLUDE_WIKIHOW_QUIZZES=true

# Include hot tub care tips
INCLUDE_HOTTUB=true

# Include gardening tips (vegetables and hydroponics)
INCLUDE_GARDENING=true

# Include 3D printing tips
INCLUDE_PRINTING3D=true

# Include camping tips
INCLUDE_CAMPING=true

# Include a daily one-liner joke (renders bare, no title)
INCLUDE_JOKE=true

# Include historical events
INCLUDE_EVENTS=true

# Maximum number of notable people to display (births + deaths combined)
MAX_PEOPLE=2

# Directory for event history cache (prevents repeating events)
CACHE_DIR=.cache

# Number of weeks before allowing an event to be posted again
CONTENT_ROTATION_WEEKS=6

# Testing Configuration
# Override the date seed for testing different fun facts without waiting for date changes
# Format: YYYYMMDD (e.g., 20251125 for November 25, 2025)
# Set to 0 to use current date (default behavior)
# Examples: TEST_DATE_SEED=20251201 (test December 1st content)
#           TEST_DATE_SEED=20251225 (test Christmas Day content)
TEST_DATE_SEED=0

# Custom event selection prompt (optional)
# Leave empty to use default prompt with diversity scoring
EVENT_SELECTION_PROMPT=
